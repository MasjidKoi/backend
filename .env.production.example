# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.production and fill in real values. NEVER commit .env.production.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Generate secrets:
#   openssl rand -base64 32            # JWT secret, DB / redis / minio passwords
#   uv run python scripts/gen_service_token.py   # service-role key (after JWT secret set)
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── Public domains (point DNS A/AAAA records at this host) ───────────────────
# Caddy auto-provisions TLS certs for each. ACME_EMAIL gets expiry notices.
ACME_EMAIL=ops@masjidkoi.me
API_DOMAIN=api.masjidkoi.me
AUTH_DOMAIN=auth.masjidkoi.me
CDN_DOMAIN=cdn.masjidkoi.me
APP_DOMAIN=app.masjidkoi.me

# Browser origins allowed to call the API (credentialed CORS). Comma-separated.
# Must include the admin panel's real origin (APP_DOMAIN). If unset, the API
# defaults to https://app.masjidkoi.me in production.
CORS_ORIGINS=https://app.masjidkoi.me

# ── Database ─────────────────────────────────────────────────────────────────
# Keep POSTGRES_USER=masjidkoi — scripts/init-db.sql grants the auth schema to it
# by name. Only harden the password.
POSTGRES_USER=masjidkoi
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=masjidkoi
# FastAPI → PgBouncer (internal network). edoburu/pgbouncer listens on 5432.
DATABASE_URL=postgresql+asyncpg://masjidkoi:CHANGE_ME_strong_random@pgbouncer:5432/masjidkoi

# ── GoTrue (Auth) ────────────────────────────────────────────────────────────
GOTRUE_JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
GOTRUE_SERVICE_ROLE_KEY=CHANGE_ME_run_gen_service_token
GOTRUE_URL=http://gotrue:9999
GOTRUE_EXTERNAL_URL=https://auth.masjidkoi.me
FRONTEND_URL=https://app.masjidkoi.me
# Comma-separated allowed redirect targets for invite / password-reset flows.
GOTRUE_URI_ALLOW_LIST=https://app.masjidkoi.me,https://app.masjidkoi.me/invite/accept,https://app.masjidkoi.me/password/reset-confirm

# ── Storage (S3 / MinIO) ─────────────────────────────────────────────────────
MINIO_ROOT_USER=masjidkoi-prod
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_random
# boto3 talks to MinIO internally; client URLs are built from S3_PUBLIC_URL.
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=masjidkoi-prod
AWS_SECRET_ACCESS_KEY=CHANGE_ME_strong_random
S3_PUBLIC_URL=https://cdn.masjidkoi.me

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_random
REDIS_URL=redis://:CHANGE_ME_strong_random@redis:6379/0

# ── Email (real SMTP — GoTrue + app notifications) ───────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# App-side mailer (app/core/config.py) reads SMTP_PASSWORD + SMTP_ENABLED.
SMTP_PASSWORD=
SMTP_ENABLED=true
# Use a domain address with SPF/DKIM/DMARC aligned to your sending domain.
SMTP_FROM=noreply@masjidkoi.me

# ── Expo Push ────────────────────────────────────────────────────────────────
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# ── SSLCommerz (PRODUCTION gateway) ──────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://securepay.sslcommerz.com
PUBLIC_API_BASE_URL=https://api.masjidkoi.me
APP_DEEP_LINK_SCHEME=masjidkoi

# ── NGO identity (donation receipts) ─────────────────────────────────────────
NGO_NAME=MasjidKoi Foundation
NGO_REGISTRATION_NUMBER=
NGO_CONTACT_EMAIL=
NGO_WEBSITE=
NGO_ADDRESS=
